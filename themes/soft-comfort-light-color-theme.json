    "notifications.background": "#f8f6f0",
    "notifications.border": "#ddd8cc",
    "peekView.border": "#d9d3c4",
    "peekViewEditor.background": "#ebe7dd",
    "peekViewResult.background": "#ebe7dd",
    "peekViewTitle.background": "#f8f6f0",
