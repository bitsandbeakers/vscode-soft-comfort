    "notifications.background": "#f2f2f3",
    "notifications.border": "#dcdddf",
    "peekView.border": "#cfd0d3",
    "peekViewEditor.background": "#e6e6e8",
    "peekViewResult.background": "#e6e6e8",
    "peekViewTitle.background": "#f2f2f3",
    "breadcrumb.foreground": "#7c8088",
    "breadcrumb.focusForeground": "#3d3f42",
