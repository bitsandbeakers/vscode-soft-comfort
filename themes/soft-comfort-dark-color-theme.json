  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#858c97", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.other.using", "keyword.other.import"],
      "settings": { "foreground": "#c3a2d4" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison"],
      "settings": { "foreground": "#9da3ad" }
    },
    {
      "name": "Word operators",
      "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.word"],
      "settings": { "foreground": "#c3a2d4" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#9da3ad" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#a8c38f" }
    },
    {
      "name": "String escapes and regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
      "settings": { "foreground": "#9cc2c2" }
    },
    {
      "name": "Template expression",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#c3a2d4" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant"],
      "settings": { "foreground": "#dda27e" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "#8fb3d6" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.primitive", "entity.name.namespace"],
      "settings": { "foreground": "#d6bd8b" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#c4c8cf" }
    },
    {
      "name": "Language variables",
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.parameter.function.language.special"],
      "settings": { "foreground": "#c3a2d4", "fontStyle": "italic" }
    },
    {
      "name": "Properties and object keys",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml"],
      "settings": { "foreground": "#9cc2c2" }
    },
    {
      "name": "Decorators and annotations",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation"],
      "settings": { "foreground": "#d6bd8b", "fontStyle": "italic" }
    },
    {
      "name": "HTML/XML tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#8fb3d6" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#d6bd8b" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": { "foreground": "#c3a2d4" }
    },
    {
      "name": "CSS values and units",
      "scope": ["support.constant.property-value", "keyword.other.unit", "constant.other.color"],
      "settings": { "foreground": "#dda27e" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#d6bd8b", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#dda27e", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#c3a2d4", "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#a8c38f" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "#8fb3d6" }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#9cc2c2" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#a8c38f" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#de8b8b" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#8fb3d6" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#de8b8b" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#9cc2c2" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#d6bd8b",
    "class": "#d6bd8b",
    "interface": "#d6bd8b",
    "enum": "#d6bd8b",
    "typeParameter": "#d6bd8b",
    "type": "#d6bd8b",
    "function": "#8fb3d6",
    "method": "#8fb3d6",
    "property": "#9cc2c2",
    "enumMember": "#dda27e",
    "parameter": "#c4c8cf",
    "variable": "#c4c8cf",
    "variable.readonly": "#dda27e",
    "variable.defaultLibrary": "#dda27e",
    "selfParameter": { "foreground": "#c3a2d4", "italic": true },
    "decorator": { "foreground": "#d6bd8b", "italic": true }
  }
}
