  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Soft Comfort Light",
  "workbench.preferredDarkColorTheme": "Soft Comfort Dark",
  "editor.fontFamily": "'Fira Code', 'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
  "editor.fontWeight": "550",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.3,
  "editor.cursorBlinking": "solid",
  "editor.minimap.enabled": false
}
