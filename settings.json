{
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Soft Comfort Light",
  "workbench.preferredDarkColorTheme": "Soft Comfort Dark",
  "editor.fontFamily": "'JetBrains Mono', 'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
  "editor.fontWeight": "600",
  "editor.fontSize": 15,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.4,
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 4,
  "markdown.preview.fontFamily": "'Literata', 'Literata 12pt', Georgia, serif",
  "markdown.preview.fontSize": 24,
  "markdown.preview.lineHeight": 1.45,
  "editor.minimap.enabled": false,
  "[markdown]": {
    "editor.fontFamily": "'IBM Plex Sans', 'JetBrains Mono', 'Segoe UI', sans-serif",
    "editor.fontSize": 15,
    "editor.lineHeight": 1.75,
    "editor.letterSpacing": 0,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 75,
    "editor.wrappingIndent": "indent",
    "editor.lineNumbers": "off",
    "editor.glyphMargin": false,
    "editor.folding": false,
    "editor.rulers": [],
    "editor.renderWhitespace": "none",
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    }
  },
  "[plaintext]": {
    "editor.fontFamily": "'IBM Plex Sans', 'JetBrains Mono', 'Segoe UI', sans-serif",
    "editor.fontSize": 15,
    "editor.lineHeight": 1.75,
    "editor.letterSpacing": 0,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 75,
    "editor.wrappingIndent": "indent",
    "editor.lineNumbers": "off",
    "editor.glyphMargin": false,
    "editor.folding": false,
    "editor.rulers": [],
    "editor.renderWhitespace": "none",
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    }
  }
}
